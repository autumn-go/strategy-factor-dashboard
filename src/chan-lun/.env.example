# 复制为 .env 后按需填写(run_daily.sh 会自动 source)。
# 真实 webhook / token 属敏感信息, 请勿提交到公开仓库。

# ---- 飞书推送 ----
# none=不推送(默认) / webhook=群自定义机器人 / bot=应用机器人(需 app 凭证)
CHAN_FEISHU_MODE=webhook
# webhook 模式: 群自定义机器人完整地址
CHAN_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# bot 模式(可选): 目标群 / 目标用户
# CHAN_FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxx
# CHAN_FEISHU_OPENID=ou_xxxxxxxxxxxxxxxx

# ---- 公网报告 ----
# publish_report.py 上传后由 GitHub Pages 提供的地址(飞书卡片按钮直达)
CHAN_PAGES_URL=https://your-name.github.io/chan-report/

# ---- GitHub 发布令牌(勿提交) ----
# publish_report.py 读取顺序: 环境变量 GITHUB_TOKEN > /tmp/ghtoken > ~/.ghtoken
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ---- 运行环境(可选, 一般不用设) ----
# CHAN_VENV=/path/to/venv      # 自定义 venv 路径
# CHAN_PYTHON=/usr/bin/python3 # 建 venv 用的 python3
